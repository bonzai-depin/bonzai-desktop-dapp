{
  "name": "bonzai",
  "productName": "BonzAI",
  "version": "0.9.7",
  "description": "1-click Sovereign AI deployment, training & serving. This is BonzAI !",
  "main": ".vite/build/main.js",
  "type": "module",
  "scripts": {
    "start": "npm run build:main && npm run build:preload && concurrently \"vite --config vite.renderer.config.ts\" \"electron .\"",
    "start:electron": "electron .",
    "build:main": "vite build --config vite.main.config.ts --outDir .vite/build",
    "build:preload": "vite build --config vite.preload.config.ts --outDir .vite/build",
    "build:renderer": "vite build --config vite.renderer.config.ts --outDir .vite/renderer/main_window",
    "build:vite": "rm -rf .vite && npm run build:main && npm run build:preload && npm run build:renderer",
    "package": "npm run build:vite && electron-packager . BonzAI --platform=darwin --arch=arm64 --out=out --overwrite --icon=src/assets/logo --ignore=\"^/(dist|bonzai|binaries|out|out-test|\\.venv|venv|build)$\"",
    "make": "npm run package && npx electron-installer-dmg out/BonzAI-darwin-arm64/BonzAI.app BonzAI --out=out/make --overwrite",
    "make:x64": "npm run build:vite && electron-packager . BonzAI --platform=darwin --arch=x64 --out=out --overwrite --icon=src/assets/logo --ignore=\"^/(dist|bonzai|binaries|out|out-test|\\.venv|venv|build)$\" && npx electron-installer-dmg out/BonzAI-darwin-x64/BonzAI.app BonzAI --out=out/make --overwrite",
    "publish": "echo 'Use CI for publishing'",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": {
    "name": "BonzAI",
    "email": "core@bonzai.sh"
  },
  "license": "BUSL",
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-dmg": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.2.0",
    "@electron-forge/plugin-vite": "github:fozziethebeat/electron-forge-plugin-vite-esm#plugin-vite-esm",
    "@electron-forge/publisher-github": "^7.4.0",
    "@types/markdown-it": "^14.1.2",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vitejs/plugin-vue": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "daisyui": "^4.4.17",
    "electron": "^28.0.0-beta.11",
    "electron-installer-dmg": "^5.0.1",
    "eslint": "^8.55.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "dependencies": {
    "@walletconnect/ethereum-provider": "^2.23.1",
    "axios": "^1.7.9",
    "cannon-es": "^0.20.0",
    "canvas-confetti": "^1.9.4",
    "electron-dl": "^4.0.0",
    "electron-squirrel-startup": "^1.0.0",
    "electron-store": "^8.1.0",
    "ethers": "^6.16.0",
    "ffmpeg-static-electron-forge": "^1.1.7",
    "node-llama-cpp": "^3.11.0",
    "openai": "^4.20.1",
    "p5": "^2.0.5",
    "pinia": "^3.0.4",
    "ps-tree": "^1.2.0",
    "socket.io-client": "^4.8.1",
    "systeminformation": "^5.23.5",
    "three": "^0.174.0",
    "update-electron-app": "^3.0.0",
    "uuid": "^9.0.1",
    "vite-plugin-static-copy": "^1.0.5",
    "vue": "^3.2.13",
    "vue-clipboard3": "^2.0.0",
    "vue-markdown-render": "^2.2.1"
  },
  "optionalDependencies": {
    "appdmg": "^0.6.6"
  }
}
