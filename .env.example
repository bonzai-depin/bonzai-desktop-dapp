# ═══════════════════════════════════════════════════════════════════════════
# BonzAI Desktop App - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values

# ═══════════════════════════════════════════════════════════════════════════
# GITHUB & RELEASES
# ═══════════════════════════════════════════════════════════════════════════

# GitHub personal access token for releases
GITHUB_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════
# WALLETCONNECT
# ═══════════════════════════════════════════════════════════════════════════

# WalletConnect Cloud project ID (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# Canonical protocol chain. Robinhood Chain (4663) is the default.
VITE_BONZAI_ECONOMY_CHAIN_ID=4663
VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Resolve this through the canonical Arbitrum bridge after the first L1 deposit.
# Never deploy an independently mintable BONZAI token on Robinhood Chain.
VITE_BONZAI_TOKEN_ROBINHOOD_ADDRESS=

# Production protocol deployments. Generic names apply to the selected economy
# chain; chain-suffixed variants such as *_ARBITRUM_ADDRESS are also supported.
VITE_BONZAI_UNLOCK_ADDRESS=
VITE_BONZAI_SKILL_REGISTRY_ADDRESS=
VITE_BONZAI_SKILL_OWNERSHIP_ADDRESS=
VITE_BONZAI_COLLECTIBLES_ADDRESS=
VITE_BONZAI_COLLECTIBLES_FACTORY_ADDRESS=
VITE_BONZAI_MINT_POOL_ADDRESS=
VITE_BONZAI_ROYALTY_SPLITTER_ADDRESS=
VITE_BONZAI_FINE_TUNE_TOKEN_FACTORY_ADDRESS=
VITE_BONZAI_COMPANIONS_ADDRESS=
VITE_BONZAI_COMPANION_TOKEN_FACTORY_ADDRESS=
VITE_BONZAI_PROVIDER_REGISTRY_ADDRESS=
VITE_BONZAI_SERVICE_TIME_ADDRESS=
VITE_BONZAI_STAKING_VAULT_ADDRESS=
VITE_BONZAI_REVENUE_ROUTER_ADDRESS=
VITE_BONZAI_CONTRIBUTION_REGISTRY_ADDRESS=
VITE_BONZAI_DATASET_REGISTRY_ADDRESS=
VITE_BONZAI_MODEL_REGISTRY_ADDRESS=
VITE_BONZAI_EVALUATION_REGISTRY_ADDRESS=
VITE_BONZAI_CONTRIBUTION_SCORE_ORACLE_ADDRESS=
VITE_BONZAI_JOB_ESCROW_ADDRESS=
VITE_BONZAI_UNISWAP_HOOK_ADDRESS=
VITE_BONZAI_SKILL_ID_MAP_JSON={}
VITE_DEFAULT_COMPANION_TOKENS_JSON={}
VITE_COMPANION_TOKEN_TRADE_URL_TEMPLATE=https://app.uniswap.org/swap?chain=robinhood&outputCurrency={tokenAddress}

# Required when Ethereum is the economy chain; verify against official V4 deployments.
VITE_UNISWAP_V4_POOL_MANAGER=
VITE_UNISWAP_V4_POSITION_MANAGER=
VITE_UNISWAP_V4_UNIVERSAL_ROUTER=
VITE_UNISWAP_V4_QUOTER=
VITE_UNISWAP_V4_STATE_VIEW=

# Inputs for scripts/register-skills.js. Values must be real uploaded IPFS CIDs.
BONZAI_SKILL_REGISTRY_ADDRESS=
ROBINHOOD_PORTFOLIO_COUNCIL_SKILL_CID=
POLYMARKET_SKILL_CID=
PREDICTION_MARKET_MAKER_SKILL_CID=
ROLEPLAY_COMPANION_SKILL_CID=
MEDITATION_FORGE_SKILL_CID=
VIDEO_CAPTIONING_SKILL_CID=
TCG_ANALYSIS_SKILL_CID=
LIVE_STREAMING_SKILL_CID=
MASS_CHAT_SKILL_CID=
CHART_FORECASTER_SKILL_CID=

# Cold-start deployment. The script derives ownership from the in-app roadmap.
BONZAI_COMPANIONS_ADDRESS=
BONZAI_COMPANION_TOKEN_FACTORY_ADDRESS=
BONZAI_SKILL_OWNERSHIP_ADDRESS=
DEFAULT_COMPANION_MNEMONIC=
ATTESTATION_SIGNER_PRIVATE_KEY=
DEFAULT_COMPANION_GAS_BUFFER=0.003

# Experimental, excluded from production by default.
VITE_ENABLE_EXPERIMENTAL_JOB_BOARD=0

# ═══════════════════════════════════════════════════════════════════════════
# IRYS (ARWEAVE STORAGE)
# ═══════════════════════════════════════════════════════════════════════════

# Irys network: "devnet" for testing, "mainnet" for production
VITE_IRYS_NETWORK=devnet

# ═══════════════════════════════════════════════════════════════════════════
# LUKSO (UNIVERSAL PROFILES + LSP8)
# ═══════════════════════════════════════════════════════════════════════════

# LUKSO network: "testnet" or "mainnet"
VITE_LUKSO_NETWORK=testnet

# BonzaiLSP8Collection contract addresses (deployed via scripts/deploy-lsp8.js)
VITE_LUKSO_LSP8_TESTNET=
VITE_LUKSO_LSP8_MAINNET=

# ═══════════════════════════════════════════════════════════════════════════
# SMART CONTRACT DEPLOYMENT (Hardhat)
# ═══════════════════════════════════════════════════════════════════════════

# Private key for contract deployment (DO NOT COMMIT!)
# DEPLOYER_PRIVATE_KEY=

# Treasury address to receive mint fees (defaults to deployer if not set)
# TREASURY_ADDRESS=

# Mint fee in LYX (defaults to 0.01)
# MINT_FEE=0.01

# ═══════════════════════════════════════════════════════════════════════════
# P2P & SIGNALING (Optional)
# ═══════════════════════════════════════════════════════════════════════════

# Signaling server for P2P inference
VITE_SIGNALING_SERVER=

# ═══════════════════════════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════════════════════════

# Flask server port (default: 65000)
BONZAI_SERVER_PORT=65000

# HuggingFace token (for gated models)
HF_TOKEN=
