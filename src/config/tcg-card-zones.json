            "hp": {
              "bbox": [0.60, 0.02, 0.25, 0.06],
              "ocr_hint": "Format 'XX HP' (number BEFORE 'HP'). Neo series began transitioning to 'HP XX'.",
              "regex_pattern": "(\\d{2,3})\\s*HP|HP\\s*(\\d{2,3})",
              "priority": "critical"
            },
            "type_icon": { "bbox": [0.87, 0.02, 0.10, 0.06], "extraction_method": "color_classification", "priority": "critical" },
