{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TCG Card Layout Zones — Era-Aware OCR Reference",
  "description": "Normalized bounding box coordinates (0.0–1.0) for data fields on TCG cards, organized by era. Origin is top-left. All coordinates are [x, y, width, height]. The pipeline should detect the card era FIRST, then apply the correct zone map.",
  "version": "2.0.0",

  "era_detection": {
    "description": "Run era detection (Phase 1.5) BEFORE zone extraction. Use a VLM call on the full card to classify era.",
    "pokemon": {
      "prompt": "Look at this Pokémon card and identify its era. Check: (1) Is the border SILVER/GRAY or YELLOW? (2) Is HP shown as 'HP 120' or '120 HP'? (3) Are there dot-code barcode strips on the right edge? (4) Is there a regulation mark letter (A-I) in the bottom bar? (5) What mechanic suffix does the name have (ex/EX/GX/V/VMAX/VSTAR)? Reply with ONLY one of: base_wotc, e_card, ex_ruby, diamond_pearl, black_white, xy, sun_moon, sword_shield, scarlet_violet, mega_evolution",
      "rules": [
        "silver/gray border → scarlet_violet or mega_evolution",
        "yellow border + dot-code strips on right → e_card",
        "yellow border + 'XX HP' (HP after number) → base_wotc",
        "yellow border + GX in name → sun_moon",
        "yellow border + V/VMAX/VSTAR in name → sword_shield",
        "yellow border + EX (caps) or M-EX in name → black_white or xy",
        "yellow border + ex (lowercase) + no regulation mark → ex_ruby",
        "yellow border + LV.X → diamond_pearl",
        "regulation mark present → sun_moon or later",
        "expansion code box in bottom-left (not set symbol) → scarlet_violet+"
      ]
    },
    "yugioh": {
      "prompt": "Look at this Yu-Gi-Oh! card layout. Check: (1) Are ATK/DEF in two separate half-width boxes side by side, or one full-width area? (2) Is there a colored zone between the art and the effect text (Pendulum zone)? (3) Are there red triangular Link Arrow markers around the art frame? (4) Does the name box have sharp beveled corners or soft curved corners? Reply with ONLY one of: series1, series2_5, series6_8, series9_pendulum, series10_plus",
      "rules": [
        "split half-width ATK/DEF boxes → series1",
        "pendulum zone between art and effect → series9_pendulum",
        "link arrows around art frame → series10_plus",
        "beveled name box corners → series10_plus",
        "larger/lighter effect box, no pendulum → series6_8",
        "default classic layout → series2_5"
      ]
    },
    "mtg": {
      "prompt": "Look at this Magic: The Gathering card. Check: (1) What font is the card name in — ornate serif (Goudy Medieval), modern serif (Matrix Bold), or clean sans-serif (Beleren)? (2) Is there a silver holofoil oval stamp at the bottom center? (3) Does the text box have a colored/textured background unique to the card color, or a uniform background? Reply with ONLY one of: alpha_original, modern_8th, m15_current",
      "rules": [
        "ornate serif font + textured text box → alpha_original",
        "modern serif font + no holofoil stamp → modern_8th",
        "clean font + holofoil stamp area → m15_current"
      ]
    },
    "onepiece": {
      "prompt": "This is a One Piece TCG card. Is the art black-and-white manga style (Manga Rare) or full-color? Reply: standard or manga_rare",
      "rules": ["single consistent layout since launch, only rarity variants differ"]
    },
    "lorcana": {
      "prompt": "Look at this Lorcana card. Check: (1) Is the ink banner behind the name split into two colors (dual-ink)? (2) Does it have a 'Move Cost' on the right edge instead of Strength? (3) Is it borderless/full-art (Enchanted)? Reply with ONLY one of: standard, location, dual_ink, enchanted",
      "rules": ["base layout stable since launch, card type variants only"]
    }
  },

  "tcgs": {
